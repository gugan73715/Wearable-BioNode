        <mxCell id="KURYSRoDygEF-QiSVCdS-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hold constant voltage between two Ag/Agcl electrodes. So, Current&amp;nbsp;∝ Concentration of ions (Na+, Cl-, K+ etc..)&lt;div&gt;&lt;br&gt;Based on Kohlrausch Law, R = L/(A * G) and Ohm&#39;s Law&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="270" x="540" y="280" as="geometry" />
        </mxCell>
        <mxCell id="KURYSRoDygEF-QiSVCdS-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Measure the Half-cell potential of a Ag/Agcl electrode against a reference electrode whose potential does not depend on Cl- concentration. So, Potential ∝ log(Concentration of Cl-)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Based on Nernst equation and Nernst response (59.2mV per decade for Cl-)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="270" x="540" y="427" as="geometry" />
        </mxCell>
        <mxCell id="KURYSRoDygEF-QiSVCdS-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Drive constant current between Ag anode and a inert non-Ag/Agcl eletrode like Pt to release Ag+ from anode and form Agcl using Cl- from sweat. So, Q = I * t and Q ∝ Concentration of Cl-&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Based on Faraday&#39;s law of Electrolysis and&amp;nbsp; Nernst Equation&amp;nbsp;&amp;nbsp;&lt;/div&gt;" vertex="1">
